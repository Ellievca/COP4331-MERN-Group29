# Only the backend reads this file. Do not put these settings in frontend VITE_ variables.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27019
MONGODB_DB_NAME=StudySync_local
APP_ORIGIN=http://127.0.0.1:5173
SESSION_HOURS=8

# Production example: APP_ORIGIN=https://your-real-domain.example
# NODE_ENV=production makes cookies Secure and requires an HTTPS domain origin.
# Set TRUST_PROXY=1 only when running behind the project's one trusted Nginx proxy.
TRUST_PROXY=0

# Google Identity Services web client; no client secret is required for ID-token sign-in.
GOOGLE_CLIENT_ID=

# Production transactional email. Store real values only in the ignored server/.env.
RESEND_API_KEY=
MAIL_FROM=StudySync <accounts@auth.studysync.live>
# Generate a persistent random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_CHALLENGE_SECRET=
# Local development writes messages to ignored server/.local-mail, never to the browser.
# Use MAIL_MODE=disabled in production; Resend sends when its key/from are configured.
MAIL_MODE=file
# Require new password accounts to verify email. Existing accounts retain access.
# In production configure Resend and the challenge secret before enabling this.
EMAIL_VERIFICATION_REQUIRED=true
