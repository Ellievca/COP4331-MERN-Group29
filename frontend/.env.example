# The bundled Express + MongoDB server is the default.
# Use VITE_DATA_MODE=demo only for the browser-only prototype.
VITE_DATA_MODE=api

# A blank base URL uses Vite's /api proxy locally and the same HTTPS domain in production.
# These are public frontend settings. Never put database credentials or JWT
# signing secrets in VITE_ variables: they are included in the browser build.
VITE_API_BASE_URL=
