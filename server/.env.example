# Only the backend reads this file. Do not put these settings in frontend VITE_ variables.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27019
MONGODB_DB_NAME=StudySync_local
APP_ORIGIN=http://127.0.0.1:5173
SESSION_HOURS=8

# Production example: APP_ORIGIN=https://your-real-domain.example
# NODE_ENV=production makes cookies Secure and requires an HTTPS domain origin.
# Set TRUST_PROXY=1 only when running behind the project's one trusted Nginx proxy.
TRUST_PROXY=0
